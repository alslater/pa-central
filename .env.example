# Database — SQLite by default; no configuration needed for development.
DATABASE_TYPE=sqlite
# DATABASE_NAME=./data/pa_central.db

# PostgreSQL
# DATABASE_TYPE=postgresql
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=pa_central
# DATABASE_USER=pa_central
# DATABASE_PASSWORD=secret
# DATABASE_PASSWORD_FILE=/run/secrets/db_password   # alternative to the above
# DATABASE_SCHEMA=public
# DATABASE_SSLMODE=prefer          # disable|prefer|require|verify-ca|verify-full
# DATABASE_SSLROOTCERT=/path/ca.pem
# DATABASE_SSLCERT=/path/client.pem
# DATABASE_SSLKEY=/path/client-key.pem
