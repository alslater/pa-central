# backend/.env.example — copy to backend/.env for local development
#
# Generate strong random values for SECRET_KEY and SETTINGS_ENCRYPTION_KEY:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# ── App ───────────────────────────────────────────────────────────────────────

# DEBUG=true disables TOTP and suppresses the insecure-default key check.
# Never set this in a shared or production environment.
DEBUG=true

SECRET_KEY=changeme-use-a-long-random-string-in-production
SETTINGS_ENCRYPTION_KEY=changeme-set-in-production-32chars

# Optional: creates admin@localhost on first startup if no admin user exists yet.
# BOOTSTRAP_ADMIN_PASSWORD=supersecret

# ── Database ──────────────────────────────────────────────────────────────────

# SQLite (default, zero setup):
DATABASE_TYPE=sqlite
# DATABASE_NAME=./pa_central.db

# PostgreSQL (swap in when you need concurrent writers or horizontal scaling):
# DATABASE_TYPE=postgresql
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=pa_central
# DATABASE_USER=pa_central
# DATABASE_PASSWORD=pa_central_dev
# DATABASE_PASSWORD_FILE=/run/secrets/db_password   # alternative to the above
# DATABASE_SCHEMA=public
# DATABASE_SSLMODE=prefer          # disable|prefer|require|verify-ca|verify-full
# DATABASE_SSLROOTCERT=/path/to/ca.pem
# DATABASE_SSLCERT=/path/to/client.pem
# DATABASE_SSLKEY=/path/to/client-key.pem

# ── Auth ──────────────────────────────────────────────────────────────────────

ACCESS_TOKEN_EXPIRE_MINUTES=480
# VALKEY_URL=redis://localhost:6379/0

# ── Uvicorn dev server ────────────────────────────────────────────────────────

UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
UVICORN_RELOAD=true
UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=1

# ── Local Docker scan mode ────────────────────────────────────────────────────
# Runs scan tasks via local Docker instead of ECS — no AWS account required.
#
# Before enabling:
#   1. Build the scan image from the repo root (not from backend/):
#        docker compose --profile local-scan build scan-task
#      See docker-compose.yml and docker/scan_task/ for the image definition.
#   2. Set FLEET_SYSTEM_API_KEY below so the container can authenticate.
#   3. Set UVICORN_HOST=0.0.0.0 above so the server is reachable from containers.
#   4. SCAN_TASK_FLEET_URL defaults to http://host.docker.internal:8000
#      (works on Docker Desktop). On Linux set it explicitly:
#        SCAN_TASK_FLEET_URL=http://172.17.0.1:8000

LOCAL_DOCKER_SCAN=false
# SCAN_TASK_IMAGE=pa-central-scan-task:latest
# SCAN_TASK_FLEET_URL=http://host.docker.internal:8000

# ── System API key (required for local scan mode and cron scheduler) ──────────
# Any non-empty string works in dev. Use a strong random value in production.
# FLEET_SYSTEM_API_KEY=dev-system-key

# ── Fleet URL ─────────────────────────────────────────────────────────────────
# URL that scan containers POST results back to.
FLEET_BASE_URL=http://localhost:8000

# ── AWS / ECS (production scan mode, not needed with LOCAL_DOCKER_SCAN=true) ──
# AWS credentials are read from the environment or ~/.aws as normal.

# AWS_REGION=us-east-1
# ECS_CLUSTER_ARN=arn:aws:ecs:us-east-1:123456789012:cluster/pa-central
# SCAN_TASK_DEFINITION_ARN=arn:aws:ecs:us-east-1:123456789012:task-definition/pa-central-scan:1
# SCAN_TASK_SUBNET_IDS=subnet-aaa,subnet-bbb
# SCAN_TASK_SECURITY_GROUP_IDS=sg-xxxxxxxx

# Override for LocalStack in tests/dev (set automatically by the test suite):
# AWS_ENDPOINT_URL=http://localhost:4566
